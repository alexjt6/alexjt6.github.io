---
// Cabecera: logotipo y nombre (enlace al inicio), menú de secciones, idioma y tema.
// Es semitransparente con desenfoque y lleva abajo una barra que muestra cuánto se ha leído.
import { getRelativeLocaleUrl } from 'astro:i18n';
import LanguagePicker from './LanguagePicker.astro';
import ThemeToggle from './ThemeToggle.astro';
import { getI18n } from '../i18n';
import { profile } from '../data/profile';

const { lang, t } = getI18n(Astro.currentLocale);

// Anclas a las secciones del inicio (los id están en los componentes de sections/).
// Llevan delante la ruta del inicio ("/" o "/en/") para que funcionen desde cualquier página, como la 404.
const home = getRelativeLocaleUrl(lang);
const hasExperience = t.experience.items.length > 0;
// desktopOnly: el enlace solo se ve desde 1024 px (por debajo, el menú ya va justo de espacio)
const links = [
  { href: `${home}#projects`, label: t.nav.projects, visible: true, desktopOnly: false },
  { href: `${home}#experience`, label: t.nav.experience, visible: hasExperience, desktopOnly: false },
  { href: `${home}#technologies`, label: t.nav.technologies, visible: true, desktopOnly: true },
  { href: `${home}#about`, label: t.nav.about, visible: true, desktopOnly: false },
  { href: `${home}#cv`, label: t.nav.cv, visible: true, desktopOnly: false },
  { href: `${home}#contact`, label: t.nav.contact, visible: true, desktopOnly: false },
].filter((link) => link.visible);
---

<header class="header">
  <div class="container header-inner">
    <a class="brand" href={home}>
      {/* Logotipo con las iniciales. Decorativo (aria-hidden): el nombre ya está escrito al lado */}
      <span class="brand-mark" aria-hidden="true">{profile.initials}</span>
      {profile.name}
    </a>

    <nav class="nav" aria-label={t.nav.label}>
      <ul>
        {
          links.map((link) => (
            <li class:list={{ 'desktop-only': link.desktopOnly }}>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="tools">
      <LanguagePicker />
      <ThemeToggle />
    </div>
  </div>

  {/* Barra de progreso de lectura (decorativa): crece al bajar por la página */}
  <span class="progress" aria-hidden="true"></span>
</header>

<style>
  /* Cabecera fija: se queda arriba al hacer scroll (sticky).
     Fondo semitransparente (el mismo color que --color-bg con opacidad) y desenfoque
     (backdrop-filter): el contenido se intuye por debajo al pasar. */
  .header {
    position: sticky;
    top: 0;
    z-index: 5;
    border-bottom: 1px solid var(--color-border);
    background: light-dark(rgb(247 248 251 / 0.78), rgb(10 12 17 / 0.72));
    -webkit-backdrop-filter: blur(14px) saturate(1.6);
    backdrop-filter: blur(14px) saturate(1.6);
  }

  /* Móvil: fila 1 = nombre + herramientas, fila 2 = menú.
     En el HTML el menú va antes que las herramientas para que el orden
     del tabulador sea lógico en escritorio. */
  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s); /* en móvil, hueco pequeño: en 320 px el nombre y los botones van justos */
    padding-block: var(--space-s);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--color-text);
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap; /* el nombre nunca se parte en dos líneas (la cabecera cambiaría de altura) */
  }

  /* Cuadrado con degradado y las iniciales. Al pasar el ratón gira un poco.
     En móviles estrechos (< 384 px) no cabe junto al nombre y los botones: solo se ve desde 384 px. */
  .brand-mark {
    display: none;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.625rem;
    background: var(--gradient-button);
    box-shadow: 0 6px 16px -8px rgb(79 70 229 / 0.8);
    color: #ffffff;
    font-size: 0.7rem;
    letter-spacing: 0;
    transition:
      rotate 0.3s var(--ease-out),
      scale 0.3s var(--ease-out);
  }

  .brand:hover .brand-mark {
    rotate: -8deg;
    scale: 1.08;
  }

  @media (min-width: 24rem) {
    .brand-mark {
      display: grid;
    }
  }

  /* Tablet y portátil pequeño (768–1023 px): el menú pasa a la misma fila y no queda sitio */
  @media (min-width: 48rem) and (max-width: 63.99rem) {
    .brand-mark {
      display: none;
    }
  }

  .tools {
    display: flex;
    align-items: center;
    gap: var(--space-s);
  }

  .nav {
    order: 1; /* en móvil, pasa a la segunda fila */
    width: 100%;
  }

  /* Menú siempre en UNA fila: si no cabe (móvil estrecho), se desliza en horizontal.
     Así la cabecera fija no cambia de altura (y scroll-padding-top de global.css sigue valiendo).
     El borde derecho se difumina (mask-image) para indicar que hay más enlaces; el hueco
     del final (padding) deja que el último enlace salga de la zona difuminada. */
  .nav ul {
    display: flex;
    gap: 0.75rem;
    margin: 0;
    padding: var(--space-xs) var(--space-l) var(--space-xs) 0; /* arriba y abajo: sitio para el contorno de foco */
    overflow-x: auto;
    white-space: nowrap;
    list-style: none;
    -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 2rem), transparent);
    mask-image: linear-gradient(90deg, #000 calc(100% - 2rem), transparent);
  }

  .nav a {
    position: relative;
    display: inline-block;
    padding-block: var(--space-xs); /* área de toque más cómoda en móvil */
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  /* Subrayado con degradado que crece de izquierda a derecha al pasar el ratón */
  .nav a::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 2px;
    border-radius: 2px;
    background: var(--gradient-text);
    scale: 0 1;
    transform-origin: left;
    transition: scale 0.3s var(--ease-out);
  }

  .nav a:hover {
    color: var(--color-text);
  }

  .nav a:hover::after {
    scale: 1 1;
  }

  /* Escritorio: todo en una fila (nombre, menú, herramientas) */
  @media (min-width: 48rem) {
    .header-inner {
      flex-wrap: nowrap;
      column-gap: var(--space-m);
    }

    .nav {
      order: 0;
      width: auto;
      margin-inline-start: auto;
    }

    /* Aquí el menú cabe entero: sin difuminado ni hueco final */
    .nav ul {
      gap: var(--space-m);
      padding-inline-end: 0;
      -webkit-mask-image: none;
      mask-image: none;
    }
  }

  /* Enlaces que solo se muestran en pantallas grandes (≥ 1024 px) */
  .desktop-only {
    display: none;
  }

  @media (min-width: 64rem) {
    .desktop-only {
      display: list-item;
    }
  }

  /* Barra de progreso: animación ligada al scroll (animation-timeline: scroll()).
     Solo en navegadores que la soportan (@supports) y sin "reducir movimiento";
     en el resto no se muestra. Parte de scale 0 (vacía): así, en una página sin scroll
     (p. ej. la 404 en una pantalla grande), donde la animación no avanza, no se ve. */
  .progress {
    display: none;
  }

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .progress {
        display: block;
        position: absolute;
        inset: auto 0 -1px; /* encima de la línea inferior de la cabecera */
        height: 2px;
        background: var(--gradient-text);
        scale: 0 1;
        transform-origin: left;
        /* Propiedades sueltas en vez del atajo "animation": al compilar, el minificador
           metería animation-timeline dentro del atajo y Chrome lo daría por no válido */
        animation-name: progress;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root); /* el avance depende del scroll, no del tiempo */
      }
    }
  }

  @keyframes progress {
    to {
      scale: 1 1;
    }
  }
</style>
