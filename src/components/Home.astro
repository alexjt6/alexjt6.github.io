---
// Contenido de la página de inicio. Lo usan las dos versiones: / (es) y /en/ (en).
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from './sections/Hero.astro';
import Projects from './sections/Projects.astro';
import Experience from './sections/Experience.astro';
import Technologies from './sections/Technologies.astro';
import About from './sections/About.astro';
import Cv from './sections/Cv.astro';
import Contact from './sections/Contact.astro';
import { getI18n } from '../i18n';

const { t } = getI18n(Astro.currentLocale);
---

<BaseLayout>
  <Hero />
  <Projects />
  {/* La sección Experiencia solo aparece cuando hay alguna en src/i18n/ */}
  {t.experience.items.length > 0 && <Experience />}
  <Technologies />
  <About />
  {/* CV y Contacto: en escritorio, lado a lado; en móvil, una sección debajo de otra (sin cambios) */}
  <div class="cv-contact">
    <div class="cv-contact-inner">
      <Cv />
      <Contact />
    </div>
  </div>
</BaseLayout>

<style>
  /* Por debajo de 900 px estos dos <div> no tienen estilos: no cambian nada.
     En escritorio, el de fuera dibuja la línea superior a todo el ancho y el de dentro
     hace de contenedor con dos columnas. Cada sección mantiene su título y su id (#cv, #contact). */
  @media (min-width: 56.25rem) {
    .cv-contact {
      position: relative; /* referencia para la línea superior */
    }

    /* Línea superior que se desvanece por los lados (como la de Section.astro) */
    .cv-contact::before {
      content: '';
      position: absolute;
      inset: 0 0 auto;
      height: 1px;
      background: var(--gradient-divider);
    }

    .cv-contact-inner {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
      max-width: var(--max-width);
      margin-inline: auto;
      padding-inline: var(--container-padding);
    }

    /* :global() porque .section, .container y .panel están dentro de otros componentes.
       Se quitan la línea superior de cada sección y su margen lateral (ya los pone este bloque). */
    .cv-contact-inner > :global(.section)::before {
      display: none;
    }

    /* Los dos paneles con la misma altura: la sección, su contenedor y el panel
       se estiran (flex en columna) hasta ocupar todo el alto de la fila */
    .cv-contact-inner > :global(.section) {
      display: flex;
      flex-direction: column;
    }

    .cv-contact-inner :global(.container) {
      display: flex;
      flex: 1;
      flex-direction: column;
      padding-inline: 0;
    }

    .cv-contact-inner :global(.panel) {
      flex: 1;
    }
  }
</style>
