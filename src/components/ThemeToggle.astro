---
// Botón para alternar entre tema claro y oscuro.
// aria-pressed="true" significa "modo oscuro activado" (patrón de botón conmutador).
import { getI18n } from '../i18n';

const { t } = getI18n(Astro.currentLocale);
---

{/* Empieza oculto (hidden): sin JavaScript el botón no funcionaría, así que no se muestra */}
<button id="theme-toggle" class="theme-toggle" type="button" aria-pressed="false" aria-label={t.theme.label} hidden>
  {/* Luna: se ve en modo claro */}
  <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
  {/* Sol: se ve en modo oscuro */}
  <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
</button>

<script>
  // Astro procesa este <script> (TypeScript) y lo carga una sola vez por página.
  type Theme = 'light' | 'dark';

  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('#theme-toggle');

  // Tema activo: el elegido con el botón o, si no hay, el del sistema
  function getCurrentTheme(): Theme {
    const forced = root.dataset.theme;
    if (forced === 'light' || forced === 'dark') return forced;
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  function updateButton() {
    button?.setAttribute('aria-pressed', String(getCurrentTheme() === 'dark'));
  }

  if (button) {
    button.hidden = false;
    updateButton();

    button.addEventListener('click', () => {
      const next: Theme = getCurrentTheme() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      updateButton();
      localStorage.setItem('theme', next); // se recuerda al recargar
    });
  }
</script>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
  }

  .theme-toggle:hover {
    border-color: var(--color-accent);
  }

  .theme-toggle[hidden] {
    display: none;
  }

  /* Muestra solo el icono que toca según el estado del botón */
  .theme-toggle[aria-pressed='true'] .icon-moon,
  .theme-toggle[aria-pressed='false'] .icon-sun {
    display: none;
  }
</style>
