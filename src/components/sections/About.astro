---
// Sobre mí: texto personal, habilidades blandas, idiomas, formación y cursos.
// Los bloques con la lista o el texto vacíos no se muestran.
// En escritorio (≥ 900 px) va en dos columnas; en móvil, una debajo de otra (mismo orden).
// Cada bloque aparece con un fundido al llegar con el scroll (data-reveal, ver BaseLayout.astro).
import Section from '../Section.astro';
import { getI18n } from '../../i18n';

const { t } = getI18n(Astro.currentLocale);
---

<Section id="about" title={t.nav.about}>
  <div class="about-grid">
    {/* Columna 1: texto, habilidades blandas e idiomas */}
    <div class="column">
      {
        t.about.intro && (
          <div class="block" data-reveal>
            <p class="intro">{t.about.intro}</p>
          </div>
        )
      }

      <div class="block columns" data-reveal>
        <div>
          <h3>{t.about.softSkillsTitle}</h3>
          {/* Habilidades en forma de píldora */}
          <ul class="chips">
            {t.about.softSkills.map((skill) => <li>{skill}</li>)}
          </ul>
        </div>
        <div>
          <h3>{t.about.languagesTitle}</h3>
          <ul class="languages">
            {
              t.about.languages.map((language) => (
                <li>
                  {/* Bandera decorativa (alt vacío): el nombre del idioma ya está escrito al lado */}
                  <img class="flag" src={`/flags/${language.flag}.svg`} alt="" width="20" height="15" loading="lazy" decoding="async" />
                  <strong>{language.name}</strong>
                  {/* Nivel en una etiqueta a la derecha. Los ":" ocultos hacen que el lector de pantalla haga una pausa */}
                  <span class="level">
                    <span class="visually-hidden">: </span>
                    {language.level}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    {/* Columna 2: formación y cursos */}
    <div class="column">
      <div class="block" data-reveal>
        <h3>
          <span class="emoji" aria-hidden="true">🎓</span>
          {t.about.educationTitle}
        </h3>
        <ul class="timeline">
          {
            t.about.education.map((item) => (
              <li>
                <p class="item-title">{item.degree}</p>
                <p class="meta">
                  {item.center} · {item.years}
                </p>
                <p>{item.note}</p>
              </li>
            ))
          }
        </ul>
      </div>

      {
        t.about.courses.length > 0 && (
          <div class="block" data-reveal>
            <h3>{t.about.coursesTitle}</h3>
            <ul class="timeline">
              {t.about.courses.map((course) => (
                <li>
                  <p class="item-title">{course.url ? <a href={course.url}>{course.name}</a> : course.name}</p>
                  <p class="meta">
                    {course.provider} · {course.date}
                  </p>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </div>
</Section>

<style>
  /* Separación entre bloques (texto, idiomas, formación…) */
  .block + .block,
  .column + .column {
    margin-top: var(--space-l);
  }

  /* Texto personal algo más grande que el resto */
  .intro {
    max-width: 40rem;
    font-size: 1.125rem;
    line-height: 1.7;
  }

  /* Habilidades blandas e idiomas: una debajo de otra en móvil, lado a lado desde 768 px */
  .columns {
    display: grid;
    gap: var(--space-l);
  }

  /* Píldoras de las habilidades blandas */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chips li {
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    font-size: 0.9rem;
  }

  /* Idiomas: una fila por idioma (bandera, nombre y nivel a la derecha) */
  .languages {
    display: grid;
    gap: var(--space-s);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .languages li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .languages strong {
    font-weight: 600;
  }

  .level {
    margin-left: auto; /* empuja la etiqueta al extremo derecho */
    padding: 0.0625rem 0.5rem;
    border-radius: 999px;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .flag {
    flex-shrink: 0;
    border-radius: 2px;
    /* Borde fino para que las banderas con blanco no se pierdan sobre el fondo claro */
    box-shadow: 0 0 0 1px var(--color-border);
  }

  .emoji {
    margin-right: 0.4em;
  }

  /* Formación y cursos: línea vertical con degradado y un punto en cada elemento.
     --line-x es la posición de la línea; los puntos se centran sobre ella. */
  .timeline {
    --line-x: 0.4375rem;

    position: relative;
    display: grid;
    gap: var(--space-l);
    margin: 0;
    padding: 0 0 0 var(--space-l);
    list-style: none;
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: var(--line-x);
    width: 2px;
    border-radius: 2px;
    background: linear-gradient(var(--color-accent), var(--color-accent-2));
  }

  .timeline li {
    position: relative;
  }

  /* Punto: círculo con el fondo de la página y borde de color, encima de la línea */
  .timeline li::before {
    content: '';
    position: absolute;
    top: 0.3rem;
    left: calc(var(--line-x) + 1px - var(--space-l) - 0.4375rem); /* centro del punto = centro de la línea */
    width: 0.875rem;
    height: 0.875rem;
    border: 2px solid var(--color-accent);
    border-radius: 50%;
    background: var(--color-bg);
  }

  .timeline p {
    margin-bottom: var(--space-xs);
  }

  .timeline li > :last-child {
    margin-bottom: 0;
  }

  .item-title {
    font-weight: 600;
  }

  .meta {
    color: var(--color-muted);
  }

  @media (min-width: 48rem) {
    .columns {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Escritorio: dos columnas */
  @media (min-width: 56.25rem) {
    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
    }

    .column + .column {
      margin-top: 0;
    }
  }
</style>
