---
// CV: un botón que abre en una pestaña nueva el PDF del idioma de la página
// (web en español → cv-es.pdf, web en inglés → cv-en.pdf).
// getCv() comprueba al compilar si el PDF existe en public/: si existe, el botón se activa;
// si no, sale deshabilitado ("Próximamente"). Así basta con subir el PDF.
import Section from '../Section.astro';
import { getI18n } from '../../i18n';
import { getCv } from '../../data/cv';

const { lang, t } = getI18n(Astro.currentLocale);
const { url, available } = getCv(lang);
---

<Section id="cv" title={t.nav.cv}>
  {/* .panel y .panel-icon están en global.css (los comparte Contacto) */}
  <div class="panel" data-reveal>
    {/* Icono de documento (decorativo) */}
    <span class="panel-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path>
        <path d="M14 3v5h5M9 13h6M9 17h4"></path>
      </svg>
    </span>
    <p>{t.cv.text}</p>
    {
      available ? (
        // rel="noopener noreferrer" impide que la pestaña nueva controle esta página
        <a class="button button-primary" href={url} target="_blank" rel="noopener noreferrer">
          {t.cv.label}
          <span class="visually-hidden">{` ${t.cv.newTab}`}</span>
          <svg class="icon icon-external" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17 17 7M7 7h10v10"></path>
          </svg>
        </a>
      ) : (
        <span class="button button-disabled">
          {t.cv.label} · {t.cv.soon}
        </span>
      )
    }
  </div>
</Section>
