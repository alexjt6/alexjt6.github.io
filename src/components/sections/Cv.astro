---
// CV: un botón que abre en una pestaña nueva el PDF del idioma de la página
// (web en español → cv-es.pdf, web en inglés → cv-en.pdf).
// Al compilar se comprueba si el PDF existe en public/: si existe, el botón se activa;
// si no, sale deshabilitado ("Próximamente"). Así basta con subir el PDF.
import { existsSync } from 'node:fs';
import Section from '../Section.astro';
import { getI18n } from '../../i18n';
import { profile } from '../../data/profile';

const { lang, t } = getI18n(Astro.currentLocale);

const url = profile.cv[lang];
// El build se ejecuta desde la raíz del proyecto, por eso la ruta empieza por "public"
const available = existsSync(`public${url}`);
---

<Section id="cv" title={t.nav.cv}>
  <p>{t.cv.text}</p>
  {
    available ? (
      // rel="noopener noreferrer" impide que la pestaña nueva controle esta página
      <a class="button button-primary" href={url} target="_blank" rel="noopener noreferrer">
        {t.cv.label}
        <span class="visually-hidden">{` ${t.cv.newTab}`}</span>
      </a>
    ) : (
      <span class="button button-disabled">
        {t.cv.label} · {t.cv.soon}
      </span>
    )
  }
</Section>
