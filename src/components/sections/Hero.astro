---
// Inicio: etiqueta de estado, nombre, titular, bio corta y botones de acceso rápido (proyectos, CV y contacto).
// Detrás hay un fondo decorativo: una cuadrícula fina y dos manchas de color que se mueven despacio.
// Al cargar la página, los elementos aparecen uno tras otro (animación solo con CSS).
// En escritorio (≥ 900 px) se añade a la derecha un cuadro decorativo:
// - Si existe src/assets/foto.(jpg|jpeg|png|webp|avif), se muestra esa foto.
// - Si no, se muestra el monograma con las iniciales (AJT).
// Así, para poner o cambiar la foto basta con guardar o sustituir el archivo.
import { Image } from 'astro:assets';
import { getI18n } from '../../i18n';
import { profile } from '../../data/profile';
import { getCv } from '../../data/cv';

const { lang, t } = getI18n(Astro.currentLocale);
const cv = getCv(lang);

// import.meta.glob busca archivos que encajen con el patrón al compilar.
// Si no hay ninguno, devuelve un objeto vacío (no da error, a diferencia de un import normal).
// eager: true → los importa directamente, sin funciones asíncronas.
const photos = import.meta.glob<{ default: ImageMetadata }>('../../assets/foto.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});
// Nos quedamos con la primera que encuentre (undefined si no hay ninguna)
const photo = Object.values(photos)[0]?.default;

// Lado del cuadrado en px: 768 (el doble del tamaño máximo en pantalla, 384 px, para que se
// vea nítida en pantallas retina) o menos si la foto es más pequeña, porque Astro no amplía imágenes.
const photoSize = photo ? Math.min(768, photo.width, photo.height) : 0;
---

<div class="hero-wrap">
  {/* Fondo decorativo (aria-hidden: no aporta nada a los lectores de pantalla) */}
  <div class="hero-bg" aria-hidden="true">
    <span class="blob blob-1"></span>
    <span class="blob blob-2"></span>
  </div>

  <div class="hero container">
    <div class="hero-text">
      {/* Etiqueta con punto verde. Se oculta si hero.status está vacío en src/i18n/ */}
      {
        t.hero.status && (
          <p class="status">
            <span class="status-dot" aria-hidden="true" />
            {t.hero.status}
          </p>
        )
      }
      <h1>{profile.name}</h1>
      <p class="headline">
        <span class="gradient-text">{t.hero.headline}</span>
      </p>
      <p class="bio">{t.hero.bio}</p>

      {/* Accesos rápidos a lo que más se busca. "Ver CV" solo aparece si el PDF de este idioma está subido.
          Los iconos son decorativos (aria-hidden) y se mueven al pasar el ratón (global.css) */}
      <ul class="actions">
        <li>
          <a class="button button-primary" href="#projects">
            {t.hero.projects}
            <svg class="icon icon-down" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 5v14M19 12l-7 7-7-7"></path>
            </svg>
          </a>
        </li>
        {
          cv.available && (
            <li>
              {/* rel="noopener noreferrer" impide que la pestaña nueva controle esta página */}
              <a class="button" href={cv.url} target="_blank" rel="noopener noreferrer">
                {t.hero.cv}
                <span class="visually-hidden">{` ${t.cv.newTab}`}</span>
                <svg class="icon icon-external" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 17 17 7M7 7h10v10"></path>
                </svg>
              </a>
            </li>
          )
        }
        <li>
          <a class="button" href="#contact">
            {t.hero.contact}
            <svg class="icon icon-right" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"></path>
            </svg>
          </a>
        </li>
      </ul>
    </div>

    {/* Foto o monograma, con un cuadro de color girado detrás. Solo en escritorio. */}
    <div class="portrait">
      {
        photo ? (
          // alt="" porque es decorativa: el nombre ya está en el <h1> de al lado.
          // <Image> la recorta a cuadrado por el centro (fit cover), la reduce y la convierte a webp.
          <Image class="photo" src={photo} alt="" width={photoSize} height={photoSize} fit="cover" />
        ) : (
          // Decorativo: aria-hidden para que el lector de pantalla no lea "AJT"
          <div class="monogram" aria-hidden="true">
            <span class="gradient-text">{profile.initials}</span>
          </div>
        )
      }
    </div>
  </div>
</div>

<style>
  /* Contenedor a todo el ancho: referencia para colocar el fondo decorativo.
     isolation: isolate crea un "contexto de apilamiento" propio: el fondo (z-index: -1)
     queda detrás del texto, pero delante del fondo de la página. */
  .hero-wrap {
    position: relative;
    isolation: isolate;
  }

  /* Fondo: sube por detrás de la cabecera (semitransparente) y se desvanece por abajo (mask-image).
     overflow: hidden recorta las manchas para que no provoquen scroll horizontal. */
  .hero-bg {
    position: absolute;
    inset: -8rem 0 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, #000 60%, transparent);
    mask-image: linear-gradient(to bottom, #000 60%, transparent);
  }

  /* Cuadrícula fina: dos degradados de 1 px (líneas horizontales y verticales) que se repiten.
     La máscara radial la desvanece hacia los bordes. */
  .hero-bg::before {
    --grid-color: light-dark(rgb(15 23 42 / 0.06), rgb(255 255 255 / 0.045));

    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--grid-color) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-color) 1px, transparent 1px);
    background-size: 3.5rem 3.5rem;
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 35%, #000 20%, transparent 75%);
    mask-image: radial-gradient(ellipse 80% 70% at 50% 35%, #000 20%, transparent 75%);
  }

  /* Manchas de color: degradados radiales (más ligeros que un filtro blur) que flotan despacio */
  .blob {
    position: absolute;
    width: min(42rem, 110vw);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, var(--blob-color), transparent 65%);
    animation: float 20s ease-in-out infinite alternate;
  }

  .blob-1 {
    --blob-color: light-dark(rgb(37 99 235 / 0.16), rgb(59 130 246 / 0.22));
    top: 0;
    left: -12%;
  }

  .blob-2 {
    --blob-color: light-dark(rgb(124 58 237 / 0.14), rgb(139 92 246 / 0.2));
    top: 12%;
    right: -12%;
    animation-duration: 26s;
    animation-direction: alternate-reverse;
  }

  @keyframes float {
    to {
      transform: translate(12%, 8%) scale(1.15);
    }
  }

  .hero {
    padding-block: 3.5rem 4.5rem;
  }

  /* Entrada al cargar: cada elemento sube y aparece, uno tras otro.
     reveal-up está en global.css; "backwards" lo mantiene oculto durante su retraso. */
  .hero-text > * {
    animation: reveal-up 0.8s var(--ease-out) backwards;
  }

  .hero-text > :nth-child(2) {
    animation-delay: 0.08s;
  }

  .hero-text > :nth-child(3) {
    animation-delay: 0.16s;
  }

  .hero-text > :nth-child(4) {
    animation-delay: 0.24s;
  }

  .hero-text > :nth-child(5) {
    animation-delay: 0.32s;
  }

  /* Etiqueta de estado en forma de píldora */
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: var(--space-l);
    padding: 0.375rem 0.875rem 0.375rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    color: var(--color-muted);
    font-size: 0.875rem;
    font-weight: 500;
  }

  /* Punto verde con una onda que se expande y se desvanece (como un indicador "en directo") */
  .status-dot {
    position: relative;
    flex-shrink: 0;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-success);
  }

  .status-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: inherit;
    animation: ping 2s var(--ease-out) infinite;
  }

  @keyframes ping {
    75%,
    100% {
      scale: 2.8;
      opacity: 0;
    }
  }

  h1 {
    margin-bottom: var(--space-m);
    /* Tamaño fluido: crece con el ancho de pantalla entre 2.5rem y 3.5rem */
    font-size: clamp(2.5rem, 10vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .headline {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-wrap: balance; /* en móvil evita que "software" quede sola en la segunda línea */
  }

  .bio {
    max-width: 40rem;
    color: var(--color-muted);
    font-size: 1.1rem;
  }

  /* Botones en fila; si no caben (móvil estrecho), pasan a la línea siguiente.
     Los estilos de cada botón (.button) están en global.css */
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: var(--space-l) 0 0;
    padding: 0;
    list-style: none;
  }

  /* En móvil y tablet ni la foto ni el monograma se muestran */
  .portrait {
    display: none;
  }

  @media (min-width: 48rem) {
    .hero {
      padding-block: 5rem 6rem;
    }
  }

  /* Escritorio: texto a la izquierda y foto a la derecha, a todo el ancho.
     Los tamaños crecen con la pantalla (clamp) para que no se vea pequeño en 1920 px o más. */
  @media (min-width: 56.25rem) {
    .hero {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: var(--space-xl);
      padding-block: clamp(4.5rem, 8vw, 8rem);
    }

    h1 {
      font-size: clamp(3.5rem, 5.5vw, 5.75rem);
    }

    .headline {
      font-size: clamp(1.3rem, 1.7vw, 1.7rem);
    }

    .bio {
      font-size: 1.2rem;
    }

    /* Mismo tamaño para la foto y el monograma, así el diseño no cambia al poner la foto.
       Entra con la misma animación que el texto y después flota arriba y abajo (bob). */
    .portrait {
      position: relative;
      isolation: isolate; /* el cuadro de detrás (z-index: -1) queda detrás de la foto */
      display: block;
      width: clamp(16rem, 22vw, 24rem);
      aspect-ratio: 1;
      margin-right: 1rem; /* sitio para la esquina del cuadro girado */
      animation:
        reveal-up 0.9s var(--ease-out) 0.2s backwards,
        bob 6s ease-in-out 1.1s infinite alternate;
    }

    /* Cuadro con degradado detrás de la foto, algo girado. Al pasar el ratón gira más. */
    .portrait::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      border-radius: 2rem;
      background: var(--gradient-button);
      box-shadow: 0 30px 60px -20px rgb(79 70 229 / 0.5);
      rotate: 6deg;
      transition: rotate 0.5s var(--ease-out);
    }

    .portrait:hover::before {
      rotate: 10deg;
    }

    .photo,
    .monogram {
      width: 100%;
      height: 100%;
      border: 1px solid var(--color-border);
      border-radius: 2rem;
      box-shadow: 0 24px 48px -24px rgb(0 0 0 / 0.5);
      transition: rotate 0.5s var(--ease-out);
    }

    .portrait:hover .photo,
    .portrait:hover .monogram {
      rotate: -2deg;
    }

    .photo {
      object-fit: cover; /* por si acaso: rellena el cuadrado sin deformar la foto */
    }

    .monogram {
      display: grid;
      place-items: center;
      background: var(--color-surface);
      font-family: var(--font-display);
      font-size: clamp(5rem, 7vw, 8rem);
      font-weight: 700;
      letter-spacing: -0.04em;
    }
  }

  @keyframes bob {
    to {
      transform: translateY(-12px);
    }
  }
</style>
