---
// Inicio: nombre, titular y bio corta (los enlaces de contacto están en la sección Contacto).
// En escritorio (≥ 900 px) se añade a la derecha un cuadro decorativo:
// - Si existe src/assets/foto.(jpg|jpeg|png|webp|avif), se muestra esa foto.
// - Si no, se muestra el monograma con las iniciales (AJT).
// Así, para poner o cambiar la foto basta con guardar o sustituir el archivo.
import { Image } from 'astro:assets';
import { getI18n } from '../../i18n';
import { profile } from '../../data/profile';

const { t } = getI18n(Astro.currentLocale);

// import.meta.glob busca archivos que encajen con el patrón al compilar.
// Si no hay ninguno, devuelve un objeto vacío (no da error, a diferencia de un import normal).
// eager: true → los importa directamente, sin funciones asíncronas.
const photos = import.meta.glob<{ default: ImageMetadata }>('../../assets/foto.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});
// Nos quedamos con la primera que encuentre (undefined si no hay ninguna)
const photo = Object.values(photos)[0]?.default;
---

<div class="hero container">
  <div class="hero-text">
    <h1>{profile.name}</h1>
    <p class="headline">{t.hero.headline}</p>
    <p class="bio">{t.hero.bio}</p>
  </div>

  {
    photo ? (
      // alt="" porque es decorativa: el nombre ya está en el <h1> de al lado.
      // <Image> la recorta a cuadrado (fit cover), la reduce y la convierte a webp.
      // 704 px = el doble del tamaño máximo en pantalla (352 px), para que se vea nítida en pantallas retina.
      <Image class="photo" src={photo} alt="" width={704} height={704} fit="cover" />
    ) : (
      // Decorativo: aria-hidden para que el lector de pantalla no lea "AJT"
      <div class="monogram" aria-hidden="true">
        {profile.initials}
      </div>
    )
  }
</div>

<style>
  .hero {
    padding-block: var(--space-l);
  }

  h1 {
    margin-bottom: var(--space-s);
    /* Tamaño fluido: crece con el ancho de pantalla entre 2rem y 3rem */
    font-size: clamp(2rem, 6vw, 3rem);
  }

  .headline {
    color: var(--color-accent);
    font-size: 1.15rem;
    font-weight: 600;
  }

  .bio {
    max-width: 40rem;
    color: var(--color-muted);
    font-size: 1.1rem;
  }

  /* En móvil y tablet ni el monograma ni la foto se muestran */
  .monogram,
  .photo {
    display: none;
  }

  @media (min-width: 48rem) {
    .hero {
      padding-block: var(--space-xl);
    }
  }

  /* Escritorio: texto a la izquierda y monograma a la derecha, a todo el ancho.
     Los tamaños crecen con la pantalla (clamp) para que no se vea pequeño en 1920 px o más. */
  @media (min-width: 56.25rem) {
    .hero {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: var(--space-xl);
      padding-block: clamp(4rem, 7vw, 8rem);
    }

    h1 {
      font-size: clamp(3rem, 4.5vw, 4.75rem);
    }

    .headline {
      font-size: clamp(1.25rem, 1.6vw, 1.6rem);
    }

    .bio {
      font-size: 1.25rem;
    }

    /* Mismo tamaño y esquinas para los dos, así el diseño no cambia al poner la foto */
    .monogram,
    .photo {
      width: clamp(16rem, 20vw, 22rem);
      aspect-ratio: 1;
      border-radius: 2rem;
    }

    .photo {
      display: block;
      height: auto;
      object-fit: cover; /* por si acaso: rellena el cuadrado sin deformar la foto */
    }

    .monogram {
      display: grid;
      place-items: center;
      background: var(--color-accent);
      color: var(--color-bg);
      font-size: clamp(6rem, 7.5vw, 8.5rem);
      font-weight: 800;
      letter-spacing: -0.04em;
    }
  }
</style>
