---
// Proyectos: lee la colección "projects" (src/content/projects/) y muestra una tarjeta por proyecto.
import { getCollection } from 'astro:content';
import Section from '../Section.astro';
import ProjectCard from './ProjectCard.astro';
import { getI18n } from '../../i18n';

const { t } = getI18n(Astro.currentLocale);

// Orden: primero por `order` y, si empatan, por título
const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);
---

<Section id="projects" title={t.nav.projects}>
  {
    projects.length === 0 ? (
      <p class="empty">{t.projects.empty}</p>
    ) : (
      <div class="grid">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    )
  }
</Section>

<style>
  .empty {
    padding: var(--space-l) var(--space-m);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
    color: var(--color-muted);
    text-align: center;
  }

  /* Rejilla: 1 columna en móvil y tantas como quepan (mín. 18rem) en pantallas grandes */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(18rem, 100%), 1fr));
    gap: var(--space-m);
  }

  /* Escritorio: el aviso se alinea a la izquierda y ocupa todo el ancho
     (anula el límite de 70 caracteres de los párrafos); tarjetas de mín. 20rem (320 px) */
  @media (min-width: 56.25rem) {
    .empty {
      max-width: none;
      text-align: left;
    }

    .grid {
      grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
      gap: var(--space-l);
    }
  }
</style>
