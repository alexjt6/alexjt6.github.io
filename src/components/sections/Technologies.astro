---
// Tecnologías: logos agrupados por categoría, cada uno con su nombre debajo.
// Los datos están en src/data/profile.ts y los logos (Devicon, MIT) en public/logos/.
import Section from '../Section.astro';
import { getI18n } from '../../i18n';
import { profile } from '../../data/profile';

const { t } = getI18n(Astro.currentLocale);

// Orden de las categorías. `as const` hace que TypeScript sepa que solo son estas claves.
const categories = ['languages', 'web', 'databases', 'frameworks', 'tools'] as const;
---

<Section id="technologies" title={t.nav.technologies}>
  <div class="categories">
    {
      categories.map((category) => (
        <div>
          <h3>{t.technologies.categories[category]}</h3>
          <ul class="techs">
            {profile.technologies[category].map((tech) => (
              <li class="tech">
                {/* Logo decorativo (alt vacío): el nombre ya está escrito debajo,
                    así el lector de pantalla no lo lee dos veces */}
                <span class="logo">
                  <img src={`/logos/${tech.logo}.svg`} alt="" width="36" height="36" loading="lazy" decoding="async" />
                </span>
                <span class="name">{tech.name}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>

<style>
  .categories {
    display: grid;
    gap: var(--space-l);
  }

  h3 {
    margin-bottom: var(--space-s);
  }

  .techs {
    /* Medidas: lado de la baldosa y ancho del hueco de cada tecnología.
       El hueco es algo más ancho para que quepan nombres largos (PostgreSQL);
       los de dos palabras (Android Studio) pasan a dos líneas. */
    --tile: 3.5rem;
    --slot: 4.25rem;

    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-xs); /* entre filas | entre columnas */
    /* Margen izquierdo negativo de medio "sobrante" del hueco: así la primera baldosa
       queda alineada con el título de la categoría */
    margin: 0 0 0 calc((var(--tile) - var(--slot)) / 2);
    padding: 0;
    list-style: none;
  }

  /* Cada tecnología: baldosa con el logo y su nombre debajo, centrados */
  .tech {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    width: var(--slot);
  }

  /* "Baldosa" de cada logo. En modo oscuro es clara: así los logos oscuros
     (Astro, MariaDB…) se ven igual de bien que en modo claro. */
  .logo {
    display: grid;
    place-items: center;
    width: var(--tile);
    height: var(--tile);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: light-dark(#ffffff, #e6e8eb);
  }

  .name {
    color: var(--color-muted);
    font-size: 0.75rem;
    line-height: 1.2;
    text-align: center;
  }

  /* Tablet: 2 columnas de categorías */
  @media (min-width: 48rem) {
    .categories {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Escritorio: las 5 categorías en una fila si caben (auto-fit, mín. 12rem cada una)
     y logos algo más grandes */
  @media (min-width: 56.25rem) {
    .categories {
      grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    }

    .techs {
      --tile: 4.25rem;
      --slot: 4.5rem;
    }

    .logo img {
      width: 2.75rem;
      height: 2.75rem;
    }
  }
</style>
