---
// Estructura común de todas las páginas: <html>, <head>, cabecera, contenido y pie.

// Fuente de los títulos (Space Grotesk), autoalojada con Fontsource: al compilar, Astro copia
// sus archivos a la web. No se puede cargar de Google Fonts porque la CSP solo permite 'self'.
import '@fontsource-variable/space-grotesk';
// URL del archivo de la fuente con las letras latinas (?url = devuelve la ruta, no el contenido)
import spaceGroteskUrl from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getI18n } from '../i18n';
import { profile } from '../data/profile';

interface Props {
  /** Título de la pestaña. Si no se indica, se usa "Nombre · Portafolio". */
  title?: string;
  /** true en páginas que no deben aparecer en buscadores (p. ej. la 404). */
  noIndex?: boolean;
}

const { lang, t } = getI18n(Astro.currentLocale);
const { title = `${profile.name} · ${t.site.title}`, noIndex = false } = Astro.props;

// URLs absolutas para SEO (usan `site` de astro.config.mjs)
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const esUrl = getAbsoluteLocaleUrl('es');
const enUrl = getAbsoluteLocaleUrl('en');

// Imagen de vista previa al compartir el enlace (1200×630, en public/)
const ogImage = new URL(`/og-${lang}.png`, Astro.site);
const ogLocale = lang === 'es' ? 'es_ES' : 'en_US';
const ogLocaleAlternate = lang === 'es' ? 'en_US' : 'es_ES';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Icono al añadir la web a la pantalla de inicio del iPhone */}
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* Precarga la fuente de los títulos para que el nombre del inicio se pinte antes con ella */}
    <link rel="preload" href={spaceGroteskUrl} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={t.site.description} />
    <meta name="author" content={profile.name} />

    {
      noIndex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          {/* Dirección principal de la página y sus versiones en cada idioma */}
          <link rel="canonical" href={canonicalUrl} />
          <link rel="alternate" hreflang="es" href={esUrl} />
          <link rel="alternate" hreflang="en" href={enUrl} />
          <link rel="alternate" hreflang="x-default" href={esUrl} />

          {/* Open Graph: título, descripción e imagen al compartir el enlace (LinkedIn, WhatsApp…) */}
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content={profile.name} />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={t.site.description} />
          <meta property="og:url" content={canonicalUrl} />
          <meta property="og:locale" content={ogLocale} />
          <meta property="og:locale:alternate" content={ogLocaleAlternate} />
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:type" content="image/png" />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={t.site.ogImageAlt} />

          {/* Twitter / X usa sus propias etiquetas (tarjeta con imagen grande) */}
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={title} />
          <meta name="twitter:description" content={t.site.description} />
          <meta name="twitter:image" content={ogImage} />
          <meta name="twitter:image:alt" content={t.site.ogImageAlt} />
        </>
      )
    }

    {/*
      Aplica el tema guardado ANTES de pintar la página, para evitar un parpadeo.
      is:inline = Astro lo deja tal cual en el HTML (sin procesarlo ni moverlo).
      CSP: no necesita hash porque Astro pone la <meta> de la CSP al final del <head>
      y la CSP no se aplica a lo que va antes. Si un día sale un error de CSP en la
      consola, añadir su hash en security.csp.scriptDirective.hashes (astro.config.mjs).
    */}
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'light' || savedTheme === 'dark') {
        document.documentElement.dataset.theme = savedTheme;
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skipLink}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Animación de aparición al hacer scroll: los elementos con data-reveal aparecen con un
      // fundido al entrar en pantalla (los estilos están al final de global.css).
      // Solo se ocultan los que están por debajo de la pantalla al cargar: así lo que ya se ve
      // no parpadea y, si el script fallara, todo seguiría visible.
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // IntersectionObserver avisa cuando un elemento entra en la zona visible de la página
      if (!reduceMotion && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries
              .filter((entry) => entry.isIntersecting)
              .forEach((entry, index) => {
                const element = entry.target as HTMLElement;
                // Si entran varios a la vez (p. ej. una fila de tarjetas), aparecen uno tras otro.
                // Math.min limita el retraso (máx. 450 ms) para que ninguno tarde demasiado.
                element.style.setProperty('--reveal-delay', `${Math.min(index, 5) * 90}ms`);
                element.classList.replace('reveal-pending', 'reveal-in');
                observer.unobserve(element); // solo se anima la primera vez
              });
          },
          // Se activa cuando el elemento ya ha subido un 10 % por encima del borde inferior
          { rootMargin: '0px 0px -10% 0px' },
        );

        for (const element of document.querySelectorAll<HTMLElement>('[data-reveal]')) {
          if (element.getBoundingClientRect().top > window.innerHeight) {
            element.classList.add('reveal-pending');
            observer.observe(element);
          }
        }
      }
    </script>
  </body>
</html>

<style>
  /* Enlace para saltar la navegación con el teclado: solo se ve al enfocarlo */
  .skip-link {
    position: absolute;
    top: var(--space-s);
    left: var(--space-s);
    z-index: 10;
    padding: var(--space-s) var(--space-m);
    background: var(--gradient-button);
    color: #ffffff;
    border-radius: var(--radius);
    font-weight: 600;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }
</style>
